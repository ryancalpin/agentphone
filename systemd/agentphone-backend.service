[Unit]
Description=AgentPhone Backend
After=agentphone-emulator.service
Wants=agentphone-emulator.service

[Service]
Type=simple
WorkingDirectory=%h/agentphone/backend
EnvironmentFile=%h/agentphone/state/agentphone.env
Environment=PATH=%h/.local/bin:%h/agentphone/android-sdk/platform-tools:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/bin/uv run uvicorn app:app --host 127.0.0.1 --port 3008
Restart=always
RestartSec=5
StandardOutput=append:%h/agentphone/logs/backend.log
StandardError=append:%h/agentphone/logs/backend.err.log

[Install]
WantedBy=default.target
