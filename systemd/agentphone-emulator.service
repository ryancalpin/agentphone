[Unit]
Description=AgentPhone Android Emulator
After=default.target

[Service]
Type=simple
EnvironmentFile=/home/ryancalpin/agentphone/state/agentphone.env
Environment=PATH=/home/ryancalpin/agentphone/android-sdk/platform-tools:/home/ryancalpin/agentphone/android-sdk/emulator:/home/ryancalpin/agentphone/android-sdk/cmdline-tools/latest/bin:/usr/local/bin:/usr/bin:/bin
Environment=ANDROID_HOME=/home/ryancalpin/agentphone/android-sdk
Environment=ANDROID_AVD_HOME=/home/ryancalpin/agentphone/avd
ExecStart=/home/ryancalpin/agentphone/android-sdk/emulator/emulator -avd AgentPhone -no-window -gpu host -no-audio -no-boot-anim -netdelay none -netspeed full -grpc 8554
Restart=always
RestartSec=10
WorkingDirectory=/home/ryancalpin/agentphone
StandardOutput=append:/home/ryancalpin/agentphone/logs/emulator.log
StandardError=append:/home/ryancalpin/agentphone/logs/emulator.err.log

[Install]
WantedBy=default.target
